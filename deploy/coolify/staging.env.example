# Staging only. Set these names and their real values in Coolify; never commit a populated copy.
# Use infrastructure and Clerk instances dedicated to staging. Do not reuse production credentials.

# API (runtime only)
SIA_ENVIRONMENT=staging
SIA_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@POSTGRES_INTERNAL_HOST:5432/sia_staging
SIA_REDIS_URL=redis://REDIS_INTERNAL_HOST:6379/0
SIA_CLERK_JWKS_URL=https://CLERK_STAGING_ISSUER/.well-known/jwks.json
SIA_CLERK_ISSUER=https://CLERK_STAGING_ISSUER
SIA_CLERK_AUDIENCE=sia

# Web. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is required at build time and runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STAGING_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_STAGING_KEY
CLERK_JWT_TEMPLATE=sia
SIA_API_URL=http://API_INTERNAL_HOST:8000
