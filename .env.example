# Local development only. Do not store production secrets here.
POSTGRES_DB=sia
POSTGRES_USER=sia
POSTGRES_PASSWORD=local-development-only
POSTGRES_URL=postgresql+asyncpg://sia:local-development-only@postgres:5432/sia
MINIO_ROOT_USER=sia-local
MINIO_ROOT_PASSWORD=local-development-only
SIA_ENVIRONMENT=development
SIA_DATABASE_URL=postgresql+asyncpg://sia:local-development-only@postgres:5432/sia
SIA_REDIS_URL=redis://redis:6379/0
# Clerk Cloud (web). Pull keys with `clerk env pull` from apps/web; do not commit them.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# CLERK_JWT_TEMPLATE=sia
# SIA_API_URL=http://localhost:8000
#
# Clerk: use the JWKS URL and issuer of your actual Clerk instance.
# Issuer and audience are required in ALL environments.
# Production/staging and local Google OAuth: leave SIA_CLERK_SECRET_KEY unset; RS256 via JWKS only.
# SIA_CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# SIA_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# SIA_CLERK_AUDIENCE=sia
# HS256 test signing key, not a Clerk Cloud API secret; development/test ONLY.
# SIA_CLERK_SECRET_KEY=local-test-signing-key-at-least-32-bytes
# SIA_STORAGE_SIGNED_URL_SECONDS=300
# Archivos privados (R2 o MinIO compatible con S3). Vacío = la carga responde 503.
# SIA_STORAGE_ENDPOINT=http://minio:9000
# Host que el navegador puede abrir. Vacío = la firma usa SIA_STORAGE_ENDPOINT.
# En Compose local la API habla con minio y el navegador con localhost.
# SIA_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# SIA_STORAGE_BUCKET=sia-private
# SIA_STORAGE_ACCESS_KEY=sia-local
# SIA_STORAGE_SECRET_KEY=local-development-only
# SIA_STORAGE_REGION=us-east-1
